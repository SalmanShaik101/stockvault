# StockVault / StockBun Environment Variables Setup
# Copy this file to .env.local for local development

# -----------------------------------------------------------------------------
# Supabase Configuration (Database, User Auth, RLS & Product Storage)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Razorpay Configuration (Payments & Membership Subscriptions)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# -----------------------------------------------------------------------------
# Google Drive Service Account (3.5GB - 50GB Heavy ZIP File Streaming)
# -----------------------------------------------------------------------------
GDRIVE_CLIENT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com
GDRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Optional Integrations (Cloudinary / Firebase Admin)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
